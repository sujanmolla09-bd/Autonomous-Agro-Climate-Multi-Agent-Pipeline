# অফিসিয়াল পাইথন লাইটওয়েট ইমেজ ব্যবহার করা হলো
FROM python:3.10-slim

# কন্টেইনারের ভেতরের ওয়ার্কিং ডিরেক্টরি সেট করা
WORKDIR /app

# সিস্টেম ডিপেন্ডেন্সি এবং কারেন্ট লাইব্রেরি এনভায়রনমেন্ট সেটআপ
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# আপনার সম্পূর্ণ প্রোডাকশন কোড কন্টেইনারে কপি করা
COPY . .

# গুগল ক্লাউড রানের ডিফল্ট পোর্ট কমপ্লায়েন্স (Port 8080)
EXPOSE 8080

# জেমিনি ৩.৮ ফ্ল্যাশ এআই ইঞ্জিন রান করার প্রোডাকশন কমান্ড
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "app:app"]
